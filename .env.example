# Copy to .env.local for local dev.

# --- Current deploy (Vercel monolith) ---
# Blog CMS + customer auth share ONE Postgres via DATABASE_URL (same Neon DB).
# Set that same DATABASE_URL on the Vercel storefront project.
#
# --- Future split (see docs/production-architecture.md) ---
# Store/Admin call Railway via NEXT_PUBLIC_API_URL; only apps/api keeps DATABASE_URL.

# Deploy role — omit locally for both storefront + admin on one server.
# storefront = public site only | admin = admin console only
APP_ROLE=

# External API (Railway) — when set, frontends call backend instead of local /api routes
NEXT_PUBLIC_API_URL=

# Mapbox public token (pk.…) — REQUIRED for trek maps.
# Create at https://account.mapbox.com/access-tokens/ → "Create a token" or copy Default public token.
# If Mapbox says TokenRevoked, delete the old token and paste a NEW pk. token here, then restart `npm run dev`.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudinary — image CDN + admin uploads (jum1mpl0)
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Admin panel login (set strong values in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# HMAC secret for signed admin sessions (32+ random chars; required in production)
ADMIN_SESSION_SECRET=

# Customer (storefront) auth sessions — separate from admin
USER_SESSION_SECRET=

# Optional Google OAuth for customer login (OpenID Connect + PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional absolute callback override. Leave unset on Vercel so the live host
# (*.vercel.app today, custom domain later) is used automatically.
# GOOGLE_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/api/user/auth/google/callback
# Never set a localhost value on Vercel.
GOOGLE_REDIRECT_URI=

# PostgreSQL — ONE database for blog/CMS + customer auth (Neon / Supabase / local)
# Required on Vercel storefront today: same Neon/Postgres as blog.
# Also accepted: POSTGRES_URL / POSTGRES_PRISMA_URL (Neon Vercel integration).
# Enable for Production (+ Preview if you use preview deploys), then Redeploy.
DATABASE_URL=

# Public site URL for canonical links, sitemap, and JSON-LD (production)
NEXT_PUBLIC_SITE_URL=https://www.indiantreks.in

# Analytics scaffold (optional — no scripts injected until wired)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_SITE_URL=
