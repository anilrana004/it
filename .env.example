# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.

# Mapbox — interactive 3D trek route maps (optional; maps show a setup hint if empty)
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudinary — image CDN (optional; defaults to project cloud name if unset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Admin panel login (set strong values in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
