# Railway API — copy to Railway environment variables

PORT=8080
NODE_ENV=production

# Neon PostgreSQL (backend only — never on Vercel frontends)
DATABASE_URL=

# Comma-separated allowed browser origins (store + admin Vercel URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Admin authentication
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cloudinary (admin media uploads via API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Storefront cache invalidation after blog publish (store Vercel URL + shared secret)
STOREFRONT_REVALIDATE_URL=https://your-store.vercel.app/api/revalidate
REVALIDATE_SECRET=
